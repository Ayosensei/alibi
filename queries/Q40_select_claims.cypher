// Select up to 2 priority claims matching topic, slot, and requirements that haven't been asked yet
MATCH (c:Claim {by: $suspect}) WHERE $topic IN c.topics AND ($slot = 0 OR c.slot = $slot OR c.slot = 0) AND ($about = '' OR c.subject = $about OR c.kind IN ['relation', 'fact']) AND NOT c.id IN $askedClaimIds AND ALL(r IN c.requires WHERE r IN $foundEvidenceIds) RETURN c.id AS id, c.by AS by, c.kind AS kind, c.subject AS subject, c.slot AS slot, c.room AS room, c.detail AS detail, c.relationId AS relationId, c.text AS text, c.priority AS priority ORDER BY c.priority, c.id LIMIT 2
